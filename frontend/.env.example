# Скопируй в frontend/.env и подставь свои значения.

# DaData — публичный API-ключ для подсказок адреса.
# Получить: https://dadata.ru/profile/#info → "API-ключ".
# Без него поле адреса работает как обычный текстовый ввод.
VITE_DADATA_TOKEN=

# MapTiler — необязательный ключ для подложки карты.
# По умолчанию карта работает без ключа на тайлах OpenStreetMap France,
# обесцвеченных до светло-серого. Ключ нужен, только если захочется более
# аккуратной картографии: у MapTiler есть постоянный бесплатный тариф.
# (Прежний поставщик, CARTO, с 2025 отдаёт тайлы лишь по платной подписке
# и без ключа печатает поверх карты «API KEY REQUIRED».)
VITE_MAPTILER_KEY=
